{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Asia/Amman",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "update-lockfile",
  "packageRules": [
    {
      "description": "Group non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep major updates as separate PRs",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Group GitHub Actions major bumps",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github-actions major",
      "groupSlug": "github-actions-major"
    },
    {
      "description": "Laravel ecosystem majors need manual review",
      "matchPackageNames": [
        "laravel/framework",
        "filament/filament",
        "stancl/tenancy",
        "laravel/cashier",
        "phpunit/phpunit"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
